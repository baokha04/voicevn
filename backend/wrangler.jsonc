{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voicevn-tts-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VoiceVnAgent",
        "class_name": "VoiceVnAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceVnAgent"]
    }
  ]
}
